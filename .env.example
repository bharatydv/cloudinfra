# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. NEVER commit .env
# ---------------------------------------------------------------------------

# --- Core ---------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Database -----------------------------------------------------------
POSTGRES_USER=learnbase
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=learnbase
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host port the container publishes on (container-internal port stays 5432).
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+asyncpg://learnbase:change-me-in-production@postgres:5432/learnbase
TEST_DATABASE_URL=postgresql+asyncpg://learnbase:change-me-in-production@postgres:5432/learnbase_test

# --- Security -----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-generate-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_HASH_SCHEME=argon2

# --- URLs / CORS --------------------------------------------------------
FRONTEND_URL=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
API_V1_PREFIX=/api

# Host ports published by docker compose.
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=8080

# --- Rate limiting ------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute

# --- Cache (future) -----------------------------------------------------
REDIS_URL=

# --- Payments (future) --------------------------------------------------
PAYMENT_PROVIDER=noop
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCY=USD

# --- Email (future) -----------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_PROVIDER_KEY=
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=LearnBase

# --- Object storage (future) -------------------------------------------
STORAGE_PROVIDER=local
STORAGE_ENDPOINT_URL=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_BASE_URL=

# --- Analytics (future) -------------------------------------------------
ANALYTICS_PROVIDER=noop
ANALYTICS_SITE_ID=

# --- Seed admin (development only) -------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!change
SEED_ADMIN_NAME=Platform Admin

# --- Frontend (Vite) ----------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
VITE_SITE_URL=http://localhost:5173
