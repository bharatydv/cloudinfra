# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. NEVER commit .env
# ---------------------------------------------------------------------------

# --- Core ---------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Database -----------------------------------------------------------
POSTGRES_USER=learnbase
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=learnbase
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host port the container publishes on (container-internal port stays 5432).
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+asyncpg://learnbase:change-me-in-production@postgres:5432/learnbase
TEST_DATABASE_URL=postgresql+asyncpg://learnbase:change-me-in-production@postgres:5432/learnbase_test

# --- Security -----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-generate-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_HASH_SCHEME=argon2

# --- Google sign-in -----------------------------------------------------
# OAuth 2.0 Web client ID from https://console.cloud.google.com/apis/credentials
# (APIs & Services > Credentials > Create credentials > OAuth client ID >
# Web application). Add every origin the site is served from to "Authorised
# JavaScript origins" -- the browser flow is origin-checked by Google:
#   http://localhost:5173   http://localhost:8080   https://your-domain.com
# No client secret is needed: the browser returns a signed ID token and the
# backend verifies it against Google's public keys. Leave blank to switch the
# Google button off everywhere.
GOOGLE_CLIENT_ID=

# --- URLs / CORS --------------------------------------------------------
FRONTEND_URL=http://localhost:5173
# SEO-critical: PUBLIC_SITE_URL is the origin for every canonical tag, og:url
# and sitemap.xml entry, so whatever is set here is the site search engines
# treat as canonical. Point it at the real domain before launch -- the backend
# logs a warning on startup if it still looks like a placeholder in production.
PUBLIC_SITE_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
API_V1_PREFIX=/api

# Host ports published by docker compose.
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=8080

# --- Rate limiting ------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute

# --- Cache (future) -----------------------------------------------------
REDIS_URL=

# --- Payments (future) --------------------------------------------------
# noop | stripe | razorpay. Razorpay needs KEY (key_id), SECRET
# (key_secret) and WEBHOOK_SECRET from the Razorpay dashboard.
PAYMENT_PROVIDER=noop
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCY=USD

# --- Email (future) -----------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_PROVIDER_KEY=
# Default sender: verification codes, password resets, anything not to reply to.
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Inferacloud
# Sender for mail a person follows up on: test results, exam scheduling
# receipts and the team alerts about them. Blank falls back to EMAIL_FROM_ADDRESS.
EMAIL_CONTACT_ADDRESS=
# SMTP transport, used when EMAIL_PROVIDER=smtp. For Brevo: host
# smtp-relay.brevo.com, port 587 with STARTTLS, the SMTP login as the
# username and the SMTP key as the password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Where a passed challenge announces its lead, so somebody calls it back
# within the window the result page promises. Leave blank to rely on the
# Admin > Challenge leads queue alone.
SALES_NOTIFICATION_EMAIL=

# --- SMS ------------------------------------------------------------------
# One-time codes for guests starting the certification challenge. "console"
# logs the code instead of sending it; "twilio" needs all three credentials.
SMS_PROVIDER=console
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=
# Guests confirm email + phone with codes before starting the challenge. Set
# false until both EMAIL_PROVIDER and SMS_PROVIDER can really deliver, or
# guests will wait for codes that never arrive.
CONTACT_VERIFICATION_REQUIRED=true
# Minutes a code stays valid, and minutes a confirmed address stays usable.
CONTACT_VERIFICATION_CODE_EXPIRE_MINUTES=10
CONTACT_VERIFICATION_VALID_MINUTES=60

# --- Object storage (future) -------------------------------------------
STORAGE_PROVIDER=local
STORAGE_ENDPOINT_URL=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_BASE_URL=

# --- Analytics (future) -------------------------------------------------
ANALYTICS_PROVIDER=noop
ANALYTICS_SITE_ID=

# --- Seed admin (development only) -------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!change
SEED_ADMIN_NAME=Platform Admin

# --- Frontend (Vite) ----------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
VITE_SITE_URL=http://localhost:5173
